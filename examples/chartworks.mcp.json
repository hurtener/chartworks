{
  "features": {
    "mcp": true
  },
  "mcp": {
    "max_request_bytes": 10485760,
    "max_response_bytes": 16777216,
    "max_concurrent": 16,
    "timeout": "1m5s",
    "groups": [
      "discovery",
      "query",
      "byo",
      "charts"
    ],
    "allowed_hosts": [
      "localhost",
      "127.0.0.1",
      "::1"
    ]
  }
}
